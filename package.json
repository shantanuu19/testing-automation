    "test:university-fit": "wdio run ./wdio.conf.js --spec ./test/specs/university-fit.e2e.js"
  },
  "devDependencies": {
    "@wdio/cli": "^9.19.2",
    "@wdio/junit-reporter": "^9.18.2",
    "@wdio/local-runner": "^9.19.2",
    "@wdio/mocha-framework": "^9.19.2",
    "@wdio/spec-reporter": "^9.18.2",
    "chromedriver": "^156.0.2",
    "dotenv": "^16.6.1"
  },
  "allowScripts": {
    "chromedriver@156.0.2": true
  }
}
